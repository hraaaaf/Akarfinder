# AkarFinder — variables d'environnement (copier en .env.local)
# Ne jamais committer .env.local

# ── Fournisseur de base de données ───────────────────────────────────────────
DATABASE_PROVIDER=sqlite

# ── Supabase (requis si DATABASE_PROVIDER=supabase) ──────────────────────────
# URL du projet — Settings > API > Project URL
SUPABASE_URL=https://REMPLACER_PAR_TON_REF.supabase.co

# Clé anon — utilisée côté serveur avec le bearer utilisateur pour exercer la RLS.
# Cette clé n'accorde aucun privilège sans JWT et politiques RLS valides.
SUPABASE_ANON_KEY=REMPLACER_PAR_LA_CLE_ANON

# Clé service role — réservée aux opérations staff/admin explicitement isolées.
# Bypass RLS : ne jamais exposer côté client, ne jamais committer.
SUPABASE_SERVICE_ROLE_KEY=REMPLACER_PAR_LA_CLE_SERVICE_ROLE

# ── SQLite local (optionnel) ──────────────────────────────────────────────────
# SQLITE_DB_PATH=scripts/scrapers/output/akarfinder.db

# Motor purity freeze — explicit opt-in required for third-party DB ingestion
THIRD_PARTY_DB_INGESTION_ENABLED=false
# Required and non-empty for any live third-party DB ingestion. Comma-separated exact hosts.
THIRD_PARTY_DB_INGESTION_ALLOWED_HOSTS=
NIGHTLY_INGESTION_ENABLED=false
MUBAWAB_EXPANSION_ENABLED=false

# Owner listings remain fail-closed until the projection and Search canary are certified.
OWNER_LISTINGS_PUBLIC_SEARCH_ENABLED=false

# ── ANN-L6 Vivre ici ──────────────────────────────────────────────────────────
# Aucun provider n'est actif par défaut. Les endpoints publics utilisés au bake-off L5
# ne sont jamais promus implicitement en production.
# AKAR_GEO_NEARBY_PROVIDERS=overpass
# AKAR_GEO_ROUTING_PROVIDERS=valhalla
# AKAR_GEO_ISOCHRONE_PROVIDERS=valhalla
# AKAR_GEO_OVERPASS_ENDPOINT=https://VOTRE_ENDPOINT_OVERPASS
# AKAR_GEO_VALHALLA_ENDPOINT=https://VOTRE_ENDPOINT_VALHALLA
# AKAR_GEO_VALHALLA_AUTHORIZATION=Bearer VOTRE_JETON_OPTIONNEL
# URL de style MapLibre publiquement utilisable. Aucun secret dans NEXT_PUBLIC_.
# NEXT_PUBLIC_AKAR_MAP_STYLE_URL=https://VOTRE_STYLE_PUBLIC/style.json

# ── ANN-L7 Street Reality ─────────────────────────────────────────────────────
# Provider inactif tant que l'ordre, l'endpoint ET le token serveur ne sont pas explicites.
# Ne jamais exposer le token Mapillary via NEXT_PUBLIC_. Les URLs thumbnail retournées
# par le provider peuvent être temporaires et ne doivent pas être persistées sans droit explicite.
# AKAR_GEO_STREET_IMAGERY_PROVIDERS=mapillary
# AKAR_GEO_MAPILLARY_ENDPOINT=https://graph.mapillary.com
# AKAR_GEO_MAPILLARY_ACCESS_TOKEN=VOTRE_TOKEN_SERVEUR_MAPILLARY
